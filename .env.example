# Configure BOTH distinct random keys, each at least 24 characters, before remote use.
# This file is a template; the Python service reads process environment, not .env files.
READING_API_TOKEN=
READING_ADMIN_TOKEN=
READING_DATA_DIR=/var/lib/reading-service
# CLI / Caddy configuration after a domain has been assigned:
READING_SERVER=https://reading.example.com
READING_DOMAIN=reading.example.com
